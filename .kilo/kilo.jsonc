{
  "$schema": "https://app.kilo.ai/config.json",

  // Используем те же модели, что в глобальном конфиге
  "model": "routerai/deepseek/deepseek-v4-pro",
  "small_model": "routerai/deepseek/deepseek-v4-pro",

  // Главная защита: запрет выхода за пределы проекта
  "permission": {
    "external_directory": "deny",   // ← категорически не выходить из папки billiard_app
    "bash": "allow",
    "read": "allow",                // чтение разрешено везде внутри проекта
    "edit": {
      // 🔒 Абсолютные запреты
      ".env": "deny",
      ".env.*": "deny",
      ".gitignore": "ask",
      "package-lock.json": "ask",
      "package.json": "ask",        // изменение package.json — только с подтверждением
      ".kilo/**": "deny",           // запрет редактирования самой конфигурации Kilo
      ".next/**": "ask",
      "node_modules/**": "ask",
      "*.lock": "ask",

      // 🔐 Миграции — только после вашего явного разрешения
      "db/migrations/**": "ask",
      "db/*.sql": "ask",

      // ⚠️ API-роуты — с подтверждением (серверная логика)
      "app/api/**/*.ts": "ask",

      // ✅ Свободное редактирование для рабочих папок
      "app/**/*.tsx": "allow",
      "components/**/*.tsx": "allow",
      "components/**/*.ts": "allow",
      "lib/**/*.ts": "allow",
      "**/*.test.ts": "allow",
      "**/*.test.tsx": "allow",
      "**/__tests__/**": "allow",

      // Остальное — с подтверждением
      "*": "allow"
    }
  },

  // Включить автоматические git-снапшоты перед изменениями
  "snapshot": true,

  // Сжатие длинного контекста
  "compaction": {
    "auto": true,
    "prune": true
  },

  // Дополнительные инструкции (будем создавать далее)
  "instructions": [
    ".kilo/rules/**/*.md",
    "AGENTS.md"
  ]
}